/*************************************************************
 *
 * Greenup/adjacency patch targets (Patchworks approximation).
 * Generated by FEMIC from config/silviculture.mkrf.yaml.
 *
 * Criteria account: feature.area.managed.seral.le5
 * Topology distance: 100 m
 * Greenup period:   5 years
 *
 * Patchworks patch targets are soft weighted objectives, not hard
 * adjacency constraints. Use ws4 when a true greenup constraint is
 * required.
 *
 *************************************************************/

setupGreenupPatchTargets(control, int periods) {
   String criteria = "feature.area.managed.seral.le5";

   setActive("patch.sepblk.40_50.size", true, false, true);
   setMaximumPeriodic(
      "patch.sepblk.40_50.size",
      5.0,
      0,
      periods
   );
   setMaxWeight(
      "patch.sepblk.40_50.size",
      10.0
   );

   setActive("patch.sepblk.50plus.size", true, false, true);
   setMaximumPeriodic(
      "patch.sepblk.50plus.size",
      0.0,
      0,
      periods
   );
   setMaxWeight(
      "patch.sepblk.50plus.size",
      1000.0
   );

   print("Configured greenup patch targets for " + criteria);
}
